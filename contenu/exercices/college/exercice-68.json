  "sections": [
    {
      "t": "Rappel de cours",
      "blocs": [
        {
          "type": "def",
          "label": "Quel, quelle, quels, quelles",
          "text": "**Quel** est un mot qui sert à **poser une question** ou à **exclamer** (*Quel âge as-tu ? Quelle belle journée !*). Il **s’accorde** en genre et en nombre avec le **nom** auquel il se rapporte."
        },
        {
          "type": "table",
          "title": "Les quatre formes",
          "head": [
            "Forme",
            "Genre et nombre",
            "Exemple"
          ],
          "rows": [
            [
              "quel",
              "masculin singulier",
              "**Quel** âge as-tu ?"
            ],
            [
              "quelle",
              "féminin singulier",
              "**Quelle** heure est-il ?"
            ],
            [
              "quels",
              "masculin pluriel",
              "**Quels** livres lis-tu ?"
            ],
            [
              "quelles",
              "féminin pluriel",
              "**Quelles** belles mangues !"
            ]
          ]
        },
        {
          "type": "tip",
          "label": "Le truc",
          "text": "Cherche le **nom** avec lequel *quel* s’accorde : *Quelle* heure ? → *heure* est féminin singulier. Il peut être séparé du nom : *Quels sont tes amis ?*"
        }
      ]
    },
    {
      "t": "Exercices d’échauffement",
      "blocs": [
        {
          "type": "h",
          "text": "Exercice 1"
        },
        {
          "type": "exercise",
          "enonce": "Complète avec *quel, quelle, quels* ou *quelles*.",
          "items": [
            "___ jour sommes-nous ?",
            "___ heure est-il ?",
            "___ sont tes amis ?",
            "___ sont tes sœurs ?"
          ],
          "corrige": [
            "**Quel** jour sommes-nous ?",
            "**Quelle** heure est-il ?",
            "**Quels** sont tes amis ?",
            "**Quelles** sont tes sœurs ?"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 2"
        },
        {
          "type": "quiz",
          "question": "« ___ belles fleurs ! » Quel mot convient ?",
          "options": [
            "quel",
            "quelle",
            "quelles"
          ],
          "answer": 2,
          "explain": "*fleurs* est féminin pluriel : **quelles**."
        },
        {
          "type": "h",
          "text": "Exercice 3"
        },
        {
          "type": "exercise",
          "enonce": "Complète avec la bonne forme de *quel*.",
          "items": [
            "___ âge as-tu ?",
            "___ chanson aimes-tu ?",
            "___ livres lis-tu ?",
            "___ couleurs préfères-tu ?"
          ],
          "corrige": [
            "**Quel** âge as-tu ?",
            "**Quelle** chanson aimes-tu ?",
            "**Quels** livres lis-tu ?",
            "**Quelles** couleurs préfères-tu ?"
          ]
        }
      ]
    },
