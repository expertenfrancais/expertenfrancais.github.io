            "**Part-il** ?",
            "**Chantent-elles** ?"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 5"
        },
        {
          "type": "exercise",
          "enonce": "Écris la question qui correspond à la réponse (mot en gras).",
