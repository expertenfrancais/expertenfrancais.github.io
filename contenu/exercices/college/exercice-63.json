          "corrige": [
            "Réponse possible : **Où** habite-t-il ?",
            "Réponse possible : **Quand** arrive-t-elle ?",
            "Réponse possible : **Pourquoi** pleure-t-il ?",
            "Réponse possible : **Combien** de frères as-tu ?"
