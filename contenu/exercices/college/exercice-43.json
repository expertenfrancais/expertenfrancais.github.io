   "t": "Rappel de cours",
   "blocs": [
    {
     "type": "def",
     "label": "Phrase exclamative",
     "text": "La **phrase exclamative** exprime une **émotion** (joie, surprise, admiration, colère, peur…). Elle commence par une majuscule et se termine par un **point d’exclamation** ( ! )."
    },
    {
     "type": "table",
     "title": "Les mots exclamatifs",
     "head": [
      "Mot",
      "Exemple"
     ],
     "rows": [
      [
       "quel, quelle, quels, quelles (+ nom)",
       "**Quelle** belle journée !"
      ],
      [
       "comme",
       "**Comme** il fait chaud !"
      ],
      [
       "que (qu’)",
       "**Qu’**elle est gentille !"
      ],
      [
       "combien de",
       "**Combien** de monde !"
      ],
      [
       "interjection (oh, ah, aïe, bravo…)",
       "**Aïe !** J’ai mal."
      ]
     ]
    },
    {
     "type": "tip",
     "label": "Attention à l’accord",
     "text": "*Quel* s’accorde avec le nom qui suit : *quel garçon, quelle fille, quels livres, quelles fleurs*."
    }
   ]
  },
