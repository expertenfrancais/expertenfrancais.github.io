     "type": "h",
     "text": "Exercice 1"
    },
    {
     "type": "exercise",
     "enonce": "Écris le type de chaque phrase : déclarative, interrogative ou exclamative.",
     "items": [
      "Quelle belle journée !",
      "Où vas-tu ?",
      "Il pleut.",
      "Comme il fait chaud !"
     ],
     "corrige": [
      "1. **exclamative**",
      "2. **interrogative**",
      "3. **déclarative**",
      "4. **exclamative**"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 2"
    },
    {
     "type": "quiz",
     "question": "Quel signe termine une phrase exclamative ?",
     "options": [
      "le point",
      "le point d’interrogation",
      "le point d’exclamation"
     ],
     "answer": 2,
     "explain": "La phrase exclamative se termine par un **point d’exclamation**."
    },
    {
     "type": "h",
     "text": "Exercice 3"
    },
    {
     "type": "exercise",
     "enonce": "Ajoute le signe de ponctuation qui convient à la fin de chaque phrase.",
     "items": [
      "Quel beau cadeau",
      "Où est mon cahier",
      "Comme il est gentil",
      "Il fait nuit"
     ],
     "corrige": [
      "Quel beau cadeau **!**",
      "Où est mon cahier **?**",
      "Comme il est gentil **!**",
      "Il fait nuit **.**"
     ]
    }
   ]
  },
  {
