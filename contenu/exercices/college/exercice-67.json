            "Ils lisent **leur** livre.",
            "Il **leur** parle.",
            "Elles rangent **leurs** cahiers."
          ],
          "corrige": [
            "**pronom**",
            "**déterminant**",
            "**pronom**",
            "**déterminant**"
          ]
        },
        {
          "type": "h",
