  "sections": [
    {
      "t": "Rappel de cours",
      "blocs": [
        {
          "type": "def",
          "label": "Impératif présent",
          "text": "L’**impératif** exprime un **ordre**, un **conseil** ou une **défense**. Il se conjugue à **trois personnes** seulement (*tu, nous, vous*) et **sans pronom sujet** : *Chante ! Chantons ! Chantez !*"
        },
        {
          "type": "table",
          "title": "Verbes courants",
          "head": [
            "Verbe",
            "tu",
            "nous",
            "vous"
          ],
          "rows": [
            [
              "chanter",
              "chante",
              "chantons",
              "chantez"
            ],
            [
              "finir",
              "finis",
              "finissons",
              "finissez"
            ],
            [
              "être",
              "sois",
              "soyons",
              "soyez"
            ],
            [
              "avoir",
              "aie",
              "ayons",
              "ayez"
            ],
            [
              "aller",
              "va",
              "allons",
              "allez"
            ],
            [
              "faire",
              "fais",
              "faisons",
              "faites"
            ]
          ]
        },
        {
          "type": "tip",
          "label": "Attention",
          "text": "Pour les verbes du **1er groupe** (et *aller*), il n’y a pas de **-s** à la 2e personne du singulier : *Mange ! Va !*"
        }
      ]
    },
    {
      "t": "Exercices d’échauffement",
      "blocs": [
        {
          "type": "h",
          "text": "Exercice 1"
        },
        {
          "type": "exercise",
          "enonce": "Écris « impératif » ou « indicatif ».",
          "items": [
            "Viens ici !",
            "Il vient ici.",
            "Écoutez le maître.",
            "Vous écoutez le maître."
          ],
          "corrige": [
            "**impératif**",
            "**indicatif**",
            "**impératif**",
            "**indicatif**"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 2"
        },
        {
          "type": "quiz",
          "question": "Quelle phrase est un ordre ?",
          "options": [
            "Tu fermes la porte.",
            "Ferme la porte !",
            "Tu as fermé la porte."
          ],
          "answer": 1,
          "explain": "L’ordre se dit à l’**impératif**, sans pronom sujet : *Ferme la porte !*"
        },
        {
          "type": "h",
          "text": "Exercice 3"
        },
        {
          "type": "exercise",
          "enonce": "Écris à la 2e personne du singulier de l’impératif.",
          "items": [
            "chanter",
            "finir",
            "faire",
            "aller"
          ],
          "corrige": [
            "**chante**",
            "**finis**",
            "**fais**",
            "**va**"
          ]
        }
      ]
    },
