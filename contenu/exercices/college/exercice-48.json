      "il a chanté",
      "nous sommes partis",
      "elle avait fini",
      "tu auras mangé"
     ],
     "corrige": [
      "auxiliaire **a** ; participe passé **chanté**",
      "auxiliaire **sommes** ; participe passé **partis**",
      "auxiliaire **avait** ; participe passé **fini**",
      "auxiliaire **auras** ; participe passé **mangé**"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 2"
    },
    {
     "type": "quiz",
     "question": "Quel est le participe passé du verbe « prendre » ?",
     "options": [
      "pris",
      "prendu",
      "prenu"
     ],
     "answer": 0,
     "explain": "Le participe passé de *prendre* est **pris** (comme *mettre* → *mis*)."
    },
