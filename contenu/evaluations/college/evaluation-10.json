      "blocs": [
        {
          "type": "p",
          "text": "**Durée : 1 heure. Total : 20 points.** Écris proprement ; tout exercice se fait sur la copie."
        },
        {
          "type": "h",
          "text": "Exercice 1 : Trouver le sujet (4 points)"
        },
        {
          "type": "p",
          "text": "Recopie le sujet de chaque phrase. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Mes deux cousines arrivent demain.",
            "Personne ne répond.",
            "Où va ton frère ?",
            "Voyager m’enrichit."
          ]
        },
        {
          "type": "h",
          "text": "Exercice 2 : La nature du sujet (4 points)"
        },
        {
          "type": "p",
          "text": "Donne la nature du sujet en gras : nom propre, groupe nominal, pronom personnel ou autre pronom. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "**Awa** chante.",
            "**Le petit garçon** rit.",
            "**Nous** partons demain.",
            "**Chacun** rentre chez soi."
          ]
        },
        {
          "type": "h",
          "text": "Exercice 3 : Accorder le verbe avec son sujet (4 points)"
        },
        {
          "type": "p",
          "text": "Conjugue le verbe entre parenthèses au présent de l’indicatif. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "L’équipe (gagner) le match.",
            "Mon frère et moi (aller) au marché.",
            "La foule (applaudir) le chanteur.",
            "Toi et ton frère (partir) demain."
          ]
        },
        {
          "type": "h",
          "text": "Exercice 4 : Sujet sous-entendu et sujet impersonnel (4 points)"
        },
        {
          "type": "p",
          "text": "Dis quel est le sujet de chaque verbe en gras. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "**Ferme** la porte !",
            "**Mangeons** ensemble.",
            "**Il pleut** depuis ce matin.",
            "**Prenez** vos cahiers !"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 5 : Écrire des phrases (4 points)"
        },
        {
          "type": "p",
          "text": "Écris une phrase pour chaque consigne. (1 pt par phrase)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Le sujet est un groupe nominal avec un adjectif.",
            "Le sujet est un pronom indéfini.",
            "Le sujet est placé après le verbe.",
            "Le sujet est un verbe à l’infinitif."
          ]
        }
      ]
    },
