    {
      "t": "Corrigé détaillé",
      "blocs": [
        {
          "type": "h",
          "text": "Exercice 1"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Je **chanterai**",
            "Tu **finiras**",
            "Il **prendra** (le -e de « prendre » disparaît)",
