    {
      "t": "Énoncé de l’évaluation",
      "blocs": [
        {
          "type": "p",
          "text": "**Durée : 45 minutes. Total : 20 points.** Écris proprement ; tout exercice se fait sur la copie."
        },
        {
          "type": "h",
          "text": "Exercice 1 : Reconnaître le groupe (4 points)"
        },
        {
          "type": "p",
          "text": "Donne le groupe de chaque verbe. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "chanter",
            "choisir",
            "partir",
            "aller"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 2 : Le participe présent (4 points)"
        },
        {
          "type": "p",
          "text": "Écris le participe présent de chaque verbe, puis donne son groupe. (0,5 pt pour le participe présent, 0,5 pt pour le groupe)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "grandir",
            "dormir",
            "jouer",
            "réussir"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 3 : Conjuguer au présent (4 points)"
        },
        {
          "type": "p",
          "text": "Conjugue le verbe entre parenthèses au présent de l’indicatif. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Je (chanter) une chanson.",
            "Tu (finir) ton devoir.",
            "Il (prendre) son cahier.",
            "Vous (finir) à midi."
          ]
        },
        {
          "type": "h",
          "text": "Exercice 4 : Les verbes particuliers (4 points)"
        },
        {
          "type": "p",
          "text": "Conjugue le verbe entre parenthèses au présent de l’indicatif. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "J’(ouvrir) la fenêtre.",
            "Nous (manger) du riz.",
            "Nous (placer) les chaises.",
            "Ils (aller) au marché."
          ]
        },
        {
          "type": "h",
          "text": "Exercice 5 : Classer des verbes (4 points)"
        },
        {
          "type": "p",
          "text": "Classe ces huit verbes selon leur groupe : tomber, obéir, courir, voir, écrire, aller, grandir, jouer. (0,5 pt par verbe bien classé)"
        }
      ]
    },
    {
      "t": "Corrigé détaillé",
      "blocs": [
        {
          "type": "h",
          "text": "Exercice 1"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "1er groupe (infinitif en -er)",
            "2e groupe (infinitif en -ir, participe présent en -issant : choisissant)",
            "3e groupe (infinitif en -ir, participe présent en -ant : partant)",
            "3e groupe (c’est le seul verbe en -er du 3e groupe)"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 2"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "grandissant ; 2e groupe",
            "dormant ; 3e groupe",
            "jouant ; 1er groupe",
            "réussissant ; 2e groupe"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 3"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Je **chante**",
            "Tu **finis**",
            "Il **prend**",
            "Vous **finissez**"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 4"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "J’**ouvre** (3e groupe, mais mêmes terminaisons que le 1er groupe)",
            "Nous **mangeons** (le e garde le son [ʒ])",
            "Nous **plaçons** (la cédille garde le son [s])",
            "Ils **vont** (verbe très irrégulier)"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 5"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "1er groupe : **tomber, jouer**",
            "2e groupe : **obéir, grandir**",
            "3e groupe : **courir, voir, écrire, aller**"
          ]
        },
        {
          "type": "tip",
          "label": "Méthode",
          "text": "Pour trouver le groupe d’un verbe, remonte toujours à l’infinitif ; pour un verbe en -ir, regarde son participe présent (-issant ou -ant)."
        },
        {
          "type": "warn",
          "label": "Piège",
          "text": "« Aller » se termine par -er mais il appartient au 3e groupe ; « ouvrir » se conjugue comme un verbe du 1er groupe mais il est du 3e groupe."
        }
      ]
