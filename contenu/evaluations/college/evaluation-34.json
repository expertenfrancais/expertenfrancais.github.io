      "déshabiller",
      "mécontent",
      "inconnu"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 3"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "la répétition",
      "avant",
      "le contraire",
      "en dessous"
