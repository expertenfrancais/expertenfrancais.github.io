 "sections": [
  {
   "t": "Énoncé de l’évaluation",
   "blocs": [
    {
     "type": "p",
     "text": "**Durée : 45 minutes. Total : 20 points.** Écris proprement et réponds par des phrases quand c’est demandé. Tout exercice se fait sur la copie."
    },
    {
     "type": "h",
     "text": "Exercice 1 : Radical et préfixe (4 points)"
    },
    {
     "type": "p",
     "text": "Décompose chaque mot en **préfixe** et **radical**. (1 pt par mot)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "refaire",
      "impossible",
      "déplacer",
      "surnager"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 2 : Former le contraire (4 points)"
    },
    {
     "type": "p",
     "text": "Forme le contraire de chaque mot avec un préfixe de la liste : *mal-, dés-, mé-, in-.* (1 pt par réponse)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "heureux",
      "habiller",
      "content",
      "connu"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 3 : Le sens des préfixes (4 points)"
    },
    {
     "type": "p",
     "text": "Dis ce qu’exprime le préfixe en gras : **la répétition**, **le contraire**, **avant** ou **en dessous**. (1 pt par réponse)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "**re**lire",
      "**pré**voir",
      "**ir**régulier",
      "**sous**-marin"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 4 : Former des mots (4 points)"
    },
    {
     "type": "p",
     "text": "Ajoute le préfixe indiqué pour former un mot nouveau. (1 pt par réponse)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "re- + construire",
      "pré- + historique",
      "anti- + vol",
      "sur- + charger"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 5 : Orthographe des mots préfixés (4 points)"
    },
    {
     "type": "p",
     "text": "Ajoute le préfixe **in-** au mot et écris le mot obtenu, sans faute. (1 pt par réponse)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "mobile",
      "légal",
      "réel",
      "possible"
     ]
    }
   ]
  },
  {
   "t": "Corrigé détaillé",
   "blocs": [
    {
     "type": "h",
     "text": "Exercice 1"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "re- + faire",
      "im- + possible",
