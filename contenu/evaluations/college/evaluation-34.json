    },
    {
     "type": "h",
     "text": "Exercice 4"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "reconstruire",
      "préhistorique",
      "antivol",
      "surcharger"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 5"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "immobile (in- devient im- devant m)",
      "illégal (in- devient il- devant l)",
      "irréel (in- devient ir- devant r)",
      "impossible (in- devient im- devant p)"
     ]
    },
    {
     "type": "tip",
     "label": "Méthode",
     "text": "Un préfixe se place **avant** le radical ; il change le sens du mot mais pas sa classe grammaticale."
    },
    {
     "type": "warn",
     "label": "Piège",
     "text": "Le préfixe « in- » devient « im- » devant b, m, p ; « il- » devant l ; « ir- » devant r."
    }
   ]
  },
