  {
   "t": "Énoncé de l’évaluation",
   "blocs": [
    {
     "type": "p",
     "text": "**Durée : 45 minutes. Total : 20 points.** Écris proprement et réponds par des phrases quand c’est demandé. Tout exercice se fait sur la copie."
    },
    {
     "type": "h",
     "text": "Exercice 1 : Reconnaître le suffixe (4 points)"
    },
    {
     "type": "p",
     "text": "Recopie le suffixe de chaque mot. (1 pt par mot)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "lenteur",
      "joyeux",
      "jardinage",
      "rapidement"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 2 : Former des noms (4 points)"
    },
    {
     "type": "p",
     "text": "Forme un nom avec le suffixe indiqué. (1 pt par réponse)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "laver + -age",
      "fleur + -iste",
      "grand + -eur",
      "chanter + -eur"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 3 : Former des adjectifs (4 points)"
    },
    {
     "type": "p",
     "text": "Forme un adjectif avec le suffixe indiqué. (1 pt par réponse)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "aimer + -able",
      "danger + -eux",
      "nation + -al",
      "héros + -ique"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 4 : Nuances de sens (4 points)"
    },
    {
     "type": "p",
     "text": "Dis si le suffixe du mot en gras exprime un **diminutif**, un **péjoratif** ou un **collectif**. (1 pt par réponse)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "un **livret**",
      "le **feuillage**",
      "un **chauffard**",
      "une **maisonnette**"
     ]
    },
    {
     "type": "h",
     "text": "Exercice 5 : Retrouver le radical (4 points)"
    },
    {
     "type": "p",
     "text": "Donne le mot de base (radical) de chaque mot construit. (1 pt par réponse)"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "courageux",
      "lavable",
      "jardinier",
      "blancheur"
     ]
    }
   ]
  },
