    {
      "t": "Énoncé de l’évaluation",
      "blocs": [
        {
          "type": "p",
          "text": "**Durée : 1 heure. Total : 20 points.** Écris proprement ; tout exercice se fait sur la copie."
        },
        {
          "type": "h",
          "text": "Exercice 1 : Nature ou fonction ? (4 points)"
        },
        {
          "type": "p",
          "text": "Classe chaque terme dans la colonne qui convient : nature ou fonction. (0,5 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "nom",
            "sujet",
            "adverbe",
            "COD",
            "déterminant",
            "épithète",
            "pronom",
            "attribut du sujet"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 2 : La fonction d’un groupe nominal (4 points)"
        },
        {
          "type": "p",
          "text": "Donne la fonction du groupe en gras. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "**Le chat** dort.",
            "Je nourris **le chat**.",
            "Je parle **au chat**.",
            "Les élèves semblent **attentifs**."
          ]
        },
        {
          "type": "h",
          "text": "Exercice 3 : Les compléments circonstanciels (4 points)"
        },
        {
          "type": "p",
          "text": "Pour chaque phrase, indique la circonstance exprimée et la nature du complément circonstanciel en gras. (0,5 pt pour la circonstance, 0,5 pt pour la nature)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Elle marche **avec prudence**.",
            "**Ce soir**, nous partons.",
            "Il parle **doucement**.",
            "**Quand il pleut**, nous restons à la maison."
          ]
        },
        {
          "type": "h",
          "text": "Exercice 4 : Les fonctions dans le groupe nominal (4 points)"
        },
        {
          "type": "p",
          "text": "Donne la fonction du mot ou du groupe en gras : épithète, complément du nom ou apposition. (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "une **grande** maison",
            "le sac **de mon frère**",
            "Awa, **ma voisine**, chante.",
            "un panier **de mangues**"
          ]
        },
        {
          "type": "h",
          "text": "Exercice 5 : Analyse d’une phrase (4 points)"
        },
        {
          "type": "p",
          "text": "Phrase : « Ce matin, les enfants de mon quartier ont offert des fleurs à la directrice. » Relève dans cette phrase : (1 pt par réponse)"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "le sujet du verbe ;",
            "le COD ;",
            "le COI ;",
            "le complément circonstanciel (avec la circonstance)."
          ]
        }
      ]
    },
    {
      "t": "Corrigé détaillé",
      "blocs": [
